require "base64"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Build the Flutter iOS app and upload it to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: app_store_connect_key_content,
      is_key_content_base64: app_store_connect_key_is_base64?,
      duration: 1200,
      in_house: false
    )

    ipa_path = options[:ipa] || build_release_ipa(options)
    UI.user_error!("No IPA found in build/ios/ipa.") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      changelog: options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"],
      skip_waiting_for_build_processing: options.key?(:skip_waiting_for_build_processing) ? options[:skip_waiting_for_build_processing] : true,
      distribute_external: options[:distribute_external] || false,
      groups: options[:groups]
    )
  end

  desc "Upload App Store metadata and screenshots"
  lane :store_assets do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: app_store_connect_key_content,
      is_key_content_base64: app_store_connect_key_is_base64?,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Build the Flutter iOS app, upload it to App Store Connect, and submit for review"
  lane :release do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: app_store_connect_key_content,
      is_key_content_base64: app_store_connect_key_is_base64?,
      duration: 1200,
      in_house: false
    )

    skip_binary_upload = options[:skip_binary_upload].to_s == "true"
    ipa_path = if skip_binary_upload
      options[:ipa]
    else
      options[:ipa] || build_release_ipa(options)
    end
    UI.user_error!("No IPA found in build/ios/ipa.") unless ipa_path || skip_binary_upload

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_binary_upload: skip_binary_upload,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false
      }
    )
  end
end

def build_release_ipa(options)
  flutter_bin = options[:flutter_bin] || ENV["FLUTTER_BIN"] || "flutter"
  build_name = options[:build_name] || ENV["FLUTTER_BUILD_NAME"]
  build_number = options[:build_number] || ENV["FLUTTER_BUILD_NUMBER"]

  previous_rubyopt = ENV["RUBYOPT"]
  ENV["RUBYOPT"] = "-rlogger"
  workspace_root = File.expand_path("../..", __dir__)
  archive_path = File.join(workspace_root, "build/ios/archive/Runner.xcarchive")
  export_path = File.join(workspace_root, "build/ios/ipa")
  export_options_path = File.join(workspace_root, "ios/ExportOptions.plist")
  begin
    sh("cd .. && #{flutter_bin} pub get")

    build_command = [
      "cd .. &&",
      "#{flutter_bin} build ipa",
      "--release",
      "--export-method app-store"
    ]
    build_command << "--build-name #{build_name}" if build_name.to_s.strip != ""
    build_command << "--build-number #{build_number}" if build_number.to_s.strip != ""

    sh(build_command.join(" "))

    unless latest_ipa_path
      UI.message("Flutter did not produce an IPA. Exporting the existing archive with xcodebuild.")
      UI.user_error!("Archive not found at #{archive_path}") unless File.exist?(archive_path)
      UI.user_error!("Export options not found at #{export_options_path}") unless File.exist?(export_options_path)

      sh(
        "xcodebuild -exportArchive " \
        "-archivePath #{Shellwords.escape(archive_path)} " \
        "-exportPath #{Shellwords.escape(export_path)} " \
        "-exportOptionsPlist #{Shellwords.escape(export_options_path)}"
      )
    end
  ensure
    ENV["RUBYOPT"] = previous_rubyopt
  end

  options[:ipa] || latest_ipa_path
end

def app_store_connect_key_content
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  return key_content if key_content.to_s.strip != ""

  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  UI.user_error!("Set APP_STORE_CONNECT_API_KEY_CONTENT or APP_STORE_CONNECT_API_KEY_PATH.") if key_path.to_s.strip == ""

  File.read(File.expand_path(key_path))
end

def app_store_connect_key_is_base64?
  ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"].to_s.downcase == "true"
end

def latest_ipa_path
  ipa_paths = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)]
  ipa_paths.max_by { |path| File.mtime(path) }
end
